NODE_ENV=development
PORT=3000
SERVICE_NAME=maw3id-api
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_NAME=maw3id_session
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=604800
OTP_HASH_PEPPER=replace-with-at-least-32-random-characters
OTP_DELIVERY_MODE=development
# Required when OTP_DELIVERY_MODE=http (and always in production).
OTP_PROVIDER_URL=
OTP_PROVIDER_TOKEN=

# Prefer DATABASE_URL for production and managed databases.
DATABASE_URL=postgresql://maw3id:maw3id_password@localhost:5432/maw3id

# Optional local pg fallback used by legacy db.js.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=maw3id
POSTGRES_USER=maw3id
POSTGRES_PASSWORD=maw3id_password
